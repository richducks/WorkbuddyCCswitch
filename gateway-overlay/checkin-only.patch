+func accountCheckinOnly(acc *Account) bool {
+	if acc == nil || acc.Path == "" {
+		return false
+	}
+	// The console writes the marker before login publishes the credential.
+	// Fail closed if its absence cannot be confirmed.
+	_, err := os.Lstat(acc.Path + ".checkin-only")
+	return !os.IsNotExist(err)
+}
+
 // modelAccountAllowed 同时检查全局 all 与模型专属账号规则。
 // 重名文件拒绝匹配，避免不同目录下同名凭据被一起误放行。
 func modelAccountAllowed(model string, acc *Account, pool []*Account) (bool, string) {
+	if accountCheckinOnly(acc) {
+		return false, "仅用于自动签到"
+	}
+	// A second login for the same user must not bypass the check-in-only pool.
+	if acc != nil && acc.Auth != nil && acc.Auth.Account.UID != "" {
+		for _, other := range pool {
+			if other != nil && other != acc && other.Auth != nil &&
+				other.Auth.Account.UID == acc.Auth.Account.UID &&
+				other.Profile().Key == acc.Profile().Key && accountCheckinOnly(other) {
+				return false, "同一账号仅用于自动签到"
+			}
+		}
+	}
 	modelAccountFilterMu.RLock()
 	rule, configured := modelAccountFilters[normalizeModelName(model)]
 	global, globalConfigured := modelAccountFilters["all"]
