+// Observe the model before protocol adapters can substitute the request model.
+func statsObserveResolvedChunk(r *http.Request, chunk map[string]any) {
+	p := statsAttemptFor(r)
+	if p == nil {
+		return
+	}
+	model, _ := chunk["model"].(string)
+	model = normalizeModelName(model)
+	if model != "" && model != "auto" && model != p.model {
+		p.resolved = model
+	}
+}
