+	// statsObserveResolvedModel 记录上游响应实际返回的模型名（auto 分流场景用于区分真实解析结果）。
+func statsObserveResolvedModel(r *http.Request, model string) {
+	if p := statsAttemptFor(r); p != nil && model != "" {
+		p.resolved = normalizeModelName(model)
+	}
+}
+
+// statsResolvedModelFromCompletion 从聚合完成的 JSON 里取上游声明的模型名。
+func statsResolvedModelFromCompletion(data []byte) string {
+	var completion struct {
+		Model string `json:"model"`
+	}
+	if json.Unmarshal(data, &completion) != nil {
+		return ""
+	}
+	return completion.Model
+}
