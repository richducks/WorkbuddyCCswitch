# 运行容器进程的本地 UID/GID（需对 ./data 有写权限）
UID=1000
GID=1000

# 宿主机映射端口。容器内部固定 8080(网页) / 8317(模型API) / 8318(用量桥)
HOST_WEB_PORT=8080
HOST_GW_PORT=8317

# 若 8318 已被占用，可改宿主机映射端口（容器内仍为 8318）
HOST_BRIDGE_PORT=8318

# 宿主机端口绑定地址。127.0.0.1 = 仅本机访问（默认）。
# 仅在可信局域网内按需改为宿主机的专用 IPv4 地址，不支持 0.0.0.0 或公网地址。
# 三个端口都是明文 HTTP；不可信网络请使用 README 中的 SSH 隧道。
BIND_IP=127.0.0.1

# 控制台登录会话时长（小时，默认 12）。控制台鉴权始终开启，没有关闭开关；
# 脚本可用 `curl -u admin:<data/web/web.token>` 直接调用 API。
WEB_SESSION_HOURS=12

# 可选提醒：签到失败或积分 3 天内到期时 POST 一条文本消息。
# 留空即关闭。URL 里通常含 token，因此不会被写进日志。
WB_NOTIFY_WEBHOOK=
# generic / telegram / dingtalk / feishu（telegram 用 Bot API 的 sendMessage 地址）
WB_NOTIFY_KIND=generic
# 检查间隔（秒，默认 900，最小 60）
WB_NOTIFY_INTERVAL=900
