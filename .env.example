# 运行容器进程的本地 UID/GID（需对 ./data 有写权限）
UID=1000
GID=1000

# 宿主机映射端口。容器内部固定 8080(网页) / 8317(模型API) / 8318(用量桥)
HOST_WEB_PORT=8080
HOST_GW_PORT=8317

# 若 8318 已被占用，可改宿主机映射端口（容器内仍为 8318）
HOST_BRIDGE_PORT=8318

# 宿主机端口绑定地址。127.0.0.1 = 仅本机访问（默认）。
# 仅在可信局域网内按需改为宿主机的专用 IPv4 地址，不支持 0.0.0.0 或公网地址。
# 三个端口都是明文 HTTP；不可信网络请使用 README 中的 SSH 隧道。
BIND_IP=127.0.0.1

# 仅在 BIND_IP=127.0.0.1 时可设为 1，允许本机控制台免令牌访问。
WB_CONSOLE_NOAUTH=0

# 设为 1 启用用户名密码登录和角色权限。首次启动从 data/web/permissions-bootstrap 读取初始密码。
WB_CONSOLE_PERMISSIONS=0
