# 运行容器进程的本地 UID/GID（需对 ./data 有写权限）
UID=1000
GID=1000

# 宿主机映射端口。容器内部固定 8080(网页) / 8317(模型API) / 8318(用量桥)
HOST_WEB_PORT=8080
HOST_GW_PORT=8317

# 若 8318 已被占用，可改宿主机映射端口（容器内仍为 8318）
HOST_BRIDGE_PORT=8318

# 宿主机端口绑定地址。127.0.0.1 = 仅本机访问（默认）。
# 仅在可信局域网内按需改为宿主机的专用 IPv4 地址，不支持 0.0.0.0 或公网地址。
# 三个端口都是明文 HTTP；不可信网络请使用 README 中的 SSH 隧道。
BIND_IP=127.0.0.1

# 控制台账号密码登录：初始账号 admin，初始密码 123456（仅限本机 BIND_IP=127.0.0.1）。
# 局域网部署必须先修改初始密码，或预置至少 12 个字符的 data/web/permissions-bootstrap（0600 权限）。

# 可选公网 API 域名，只填主机名，不加 https:// 或路径。
# WB_API_DOMAIN=api.example.com
